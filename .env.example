# Copy to `.env` (git-ignored). Read by `docker compose` and by the backend.
# These values are for local development only.

APP_ENV=development
LOG_LEVEL=INFO

# Local database: `docker compose up -d db` starts PostgreSQL 18 with these
# credentials and creates both databases below.
POSTGRES_USER=lrs
POSTGRES_PASSWORD=lrs
POSTGRES_DB=lrs
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lrs:lrs@localhost:5432/lrs
TEST_DATABASE_URL=postgresql+psycopg://lrs:lrs@localhost:5432/lrs_test

# Signs access tokens. The app refuses to start in production with this value
# or anything shorter than 32 characters.
JWT_SECRET=dev-only-change-me

# Optional local LLM for insights (Phase 6).
# OLLAMA_BASE_URL=http://localhost:11434
